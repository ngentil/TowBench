{
  "expo": {
    "name": "Bridge Alert",
    "slug": "bridge-alert",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0a0a0a"
    },
    "android": {
      "package": "com.bridgealert.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FF6B00"
      },
      "permissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.VIBRATE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.bridgealert.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Bridge Alert monitors your location to warn you before driving under bridges that are too low for your vehicle.",
        "NSLocationWhenInUseUsageDescription": "Bridge Alert needs your location to find nearby low bridges.",
        "UIBackgroundModes": ["location", "fetch"]
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Bridge Alert monitors your location to warn you before driving under bridges that are too low for your vehicle."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": ["assets/alert.wav"]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "replace-with-your-eas-project-id"
      }
    }
  }
}
